{
  "name": "notify-fanout",
  "version": "1.0.0",
  "private": true,
  "description": "Send one CI/CD message to Telegram and other chat platforms from a single GitHub Action step.",
  "license": "MIT",
  "author": "Ashok Barua",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashokbaruaakas/notify-fanout-action.git"
  },
  "homepage": "https://github.com/ashokbaruaakas/notify-fanout-action#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "all": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
